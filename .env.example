# Copy to .env and fill in real values. .env is gitignored — never commit it.
# See docs/006-integration-hub.md (Secrets Manager) and docs/009-security.md
# for why secrets are brokered here rather than embedded in connector/agent code.

# ---------------------------------------------------------------------------
# Application — filled in as Phase 1 scaffolding (backend/, contracts/,
# infrastructure/) lands. Placeholders for now.
# ---------------------------------------------------------------------------

# ENV=local
# EVENT_BUS_BACKEND=memory   # or "redis" (see EVENT_BUS_URL) or "kafka" (see KAFKA_BOOTSTRAP_SERVERS)
# EVENT_BUS_URL=redis://localhost:6379/0
# KAFKA_BOOTSTRAP_SERVERS=localhost:29092   # docker compose up -d kafka
# KAFKA_TOPIC=ados.events
# SERVICE_AUTH_TOKEN=dev-local-only-token

# Load executive/seed_data.py's 220 fabricated manufacturing incidents (20
# hand-written + 200 generated) into the audit trail and Decision Memory at
# startup. They drive the dashboard, the KPI baseline, and every /executive/*
# analytic, so a real deployment wants this OFF (the default) and starts
# empty. Turn it on for demos, screenshots, or exploring the UI with data.
# Safe either way: seeded records use the INC-2026-* id namespace, never the
# UUIDs real incidents get, so this never collides with real history.
# SEED_DEMO_DATA=false

# Observability (backend/app/observability.py). Every request gets an id,
# echoed back as X-Request-ID, attached to every log line, and carried onto
# EventEnvelope.traceId — so an incident's HTTP request and its event trail
# join up. An inbound X-Request-ID is honoured rather than replaced.
# LOG_LEVEL=INFO
# LOG_JSON=true          # false for human-readable lines while developing

# How often each process re-reads saved LLM provider keys from Postgres.
# Only matters with more than one replica: a key saved on one would otherwise
# be invisible to the others until restart. 0 disables the refresh loop.
# LLM_SETTINGS_REFRESH_SECONDS=30

# ---------------------------------------------------------------------------
# Database (db/) — real persistence, replacing the old in-memory +
# optional-Cloudant pattern. `docker compose up -d postgres` brings up a
# local instance matching the default below exactly; then
# `./.venv/bin/alembic upgrade head` applies the schema (not automatic on
# app boot — see db/health.py's check_connectivity_or_raise). Tests point
# at a separate ados_test database instead (conftest.py), created
# automatically by infrastructure/postgres/init-test-db.sql on first
# `docker compose up`.
# ---------------------------------------------------------------------------

# DATABASE_URL=postgresql+asyncpg://ados:ados@localhost:5432/ados

# ---------------------------------------------------------------------------
# RBAC (backend/app/rbac.py, backend/app/user_store.py) — real per-user
# login, replacing the shared SERVICE_AUTH_TOKEN above for all endpoints.
# ---------------------------------------------------------------------------

# Signs/verifies session JWTs. Generate a real value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The fallback in backend/app/config.py is dev-only and forgeable by
# anyone who reads this repo's source — always set a real one.
# JWT_SECRET=

# Seeded accounts on first boot (backend/app/user_store.py's
# bootstrap_users(), only if the store is empty): emma/marcus (manager,
# $250k/$500k approval limit), sophia (executive, $5M), auditor (read-only),
# admin (user management).
#
# Leave SEED_PASSWORD unset and each account gets a RANDOM password, printed
# to the backend console once and stored only as a bcrypt hash afterwards.
# That is the safer default, but it means recreating the Postgres volume
# (docker compose down -v) silently replaces the passwords you were using and
# locks you out — recoverable only with shell access, via
# scripts/reset_user_password.py.
#
# Set SEED_PASSWORD to make first-boot seeding reproducible: a wiped database
# always comes back with this password. It cannot be used to take over an
# instance that already has accounts — bootstrap_users refuses to touch
# existing users, so it only applies to an empty store.
# SEED_PASSWORD=

# ---------------------------------------------------------------------------
# Integration Hub connectors (integrations/connectors/) — docs/006-integration-hub.md
# Unset = that connector reports not-configured and the Connector Policy
# Engine falls back to the console connector (logs + simulates success).
# No sandbox instance is available for either as of Phase 3A — set these
# when a real ServiceNow/SAP dev instance is available to test against.
# ---------------------------------------------------------------------------

# ServiceNow — the one connector wired to a real external system end to end.
# A free Personal Developer Instance is enough; no ServiceNow-side setup is
# needed (the incident/change_request tables exist on a bare instance).
# Full walkthrough + verification: docs/SERVICENOW_PILOT.md
#
# With these set, MOA HR offboarding actions (revoke building access,
# disable IT access, stop payroll) create REAL change requests instead of
# falling back to the console simulator. Verify with:
#   ./.venv/bin/python scripts/servicenow_smoke.py
# SERVICENOW_INSTANCE_URL=https://dev123456.service-now.com
# SERVICENOW_USERNAME=admin
# SERVICENOW_PASSWORD=

# SAP_BASE_URL=https://your-sap-host/sap/opu/odata/sap
# SAP_API_KEY=

# ---------------------------------------------------------------------------
# IBM Watson Natural Language Understanding (knowledge/nlu_client.py)
# Live keyword/entity/sentiment/category extraction. Get NLU_URL + an API
# key from the instance's "Service credentials" page (IBM Cloud console).
# Unset = /ai/nlu/analyze returns 502 "not configured" instead of faking
# results — no fallback text is synthesized.
# ---------------------------------------------------------------------------
# NLU_API_KEY=
# NLU_URL=https://api.<region>.natural-language-understanding.watson.cloud.ibm.com/instances/<id>

# ---------------------------------------------------------------------------
# IBM Watson Text to Speech (knowledge/tts_client.py)
# Live speech synthesis. Get TTS_URL + an API key from the instance's
# "Service credentials" page. Unset = /ai/tts/synthesize returns 502.
# ---------------------------------------------------------------------------
# TTS_API_KEY=
# TTS_URL=https://api.<region>.text-to-speech.watson.cloud.ibm.com/instances/<id>

# Pipeline opt-in: when true (and TTS is configured), every incident the
# orchestrator resolves/fails also gets a spoken briefing synthesized and
# cached in memory, fetchable at GET /incidents/{id}/briefing-audio
# (orchestrate/orchestrator.py's _finalize). Off by default because the
# TTS Lite plan's free quota is small (10,000 characters/month).
# TTS_INCIDENT_BRIEFING_ENABLED=true

# ---------------------------------------------------------------------------
# LLM provider (knowledge/local_llm_client.py) — root-cause/judgment
# reasoning for Causal Isolation, Substitution, and Impact Simulation.
# LLM_PROVIDER left unset = automatic failover: NVIDIA Nemotron (NIM cloud
# API, https://build.nvidia.com) is tried first when NEMOTRON_API_KEY is
# set, and any failure (timeout, auth error, rate limit) falls through to
# the local Ollama/Qwen model automatically. Set LLM_PROVIDER=nemotron or
# =ollama to force one exclusively with no fallback. Chosen over a managed
# IBM LLM because watsonx.ai Runtime provisioning was blocked by this
# account's catalog policy (COS/WML filtered) — see docs/ for the
# watsonx.ai path if that ever becomes available instead. Neither
# configured = the agents fall back to an honestly labeled "Rule-based
# synthesis (no live LLM configured)" explanation, never a fabricated
# "live model" claim.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=

# LOCAL_LLM_ENABLED=true
# LOCAL_LLM_URL=http://localhost:11434
# LOCAL_LLM_MODEL=qwen3:4b

# NEMOTRON_API_KEY=nvapi-...
# NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
# NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
