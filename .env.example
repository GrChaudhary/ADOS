# Copy to .env and fill in real values. .env is gitignored — never commit it.
# See docs/006-integration-hub.md (Secrets Manager) and docs/009-security.md
# for why secrets are brokered here rather than embedded in connector/agent code.

# ---------------------------------------------------------------------------
# IBM watsonx Orchestrate — ADK / CLI (`orchestrate` command)
# Used by orchestrate/ (docs/005-decision-orchestrator.md) and by agents/
# built with the ADK (docs/004-agent-framework.md).
# Get these from your watsonx Orchestrate instance: Settings -> API details
# (service instance URL) and Settings -> Generate API key.
# ---------------------------------------------------------------------------

# Service instance URL for the target Orchestrate environment.
WO_INSTANCE=

# API key for that instance (IBM Cloud / AWS). For on-prem (CPD) auth via
# username+password instead, see `orchestrate env add --help`.
WO_API_KEY=

# Source for the local Developer Edition server: "orchestrate" (IBM Cloud
# entitlement) or "myibm" (Cloud Pak for Data entitlement). Only needed if
# running `orchestrate server start` locally.
WO_DEVELOPER_EDITION_SOURCE=orchestrate

# Set to true only after the first successful `orchestrate server start`,
# to skip re-authenticating against the container registry on every run.
# WO_DEVELOPER_EDITION_SKIP_LOGIN=true

# ---------------------------------------------------------------------------
# Application — filled in as Phase 1 scaffolding (backend/, contracts/,
# infrastructure/) lands. Placeholders for now.
# ---------------------------------------------------------------------------

# ENV=local
# EVENT_BUS_BACKEND=memory   # or "redis" — see EVENT_BUS_URL below
# EVENT_BUS_URL=redis://localhost:6379/0
# SERVICE_AUTH_TOKEN=dev-local-only-token

# ---------------------------------------------------------------------------
# RBAC (backend/app/rbac.py, backend/app/user_store.py) — real per-user
# login, replacing the shared SERVICE_AUTH_TOKEN above for all endpoints.
# ---------------------------------------------------------------------------

# Signs/verifies session JWTs. Generate a real value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The fallback in backend/app/config.py is dev-only and forgeable by
# anyone who reads this repo's source — always set a real one.
# JWT_SECRET=

# CLOUDANT_DB_USERS=ados_users

# Seeded accounts on first boot (backend/app/user_store.py's
# bootstrap_users(), only if the store is empty): emma/marcus (manager,
# $250k/$500k approval limit), sophia (executive, $5M), auditor (read-only),
# admin (user management). Default passwords are printed to the backend
# log on first seed — change them via POST /auth/users or your Cloudant
# ados_users database directly before relying on this for anything real.

# ---------------------------------------------------------------------------
# Integration Hub connectors (integrations/connectors/) — docs/006-integration-hub.md
# Unset = that connector reports not-configured and the Connector Policy
# Engine falls back to the console connector (logs + simulates success).
# No sandbox instance is available for either as of Phase 3A — set these
# when a real ServiceNow/SAP dev instance is available to test against.
# ---------------------------------------------------------------------------

# SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
# SERVICENOW_USERNAME=
# SERVICENOW_PASSWORD=

# SAP_BASE_URL=https://your-sap-host/sap/opu/odata/sap
# SAP_API_KEY=

# watsonx Orchestrate ITSM connector (integrations/connectors/watsonx_itsm.py)
# — CreateIncident/CreateChangeRequest/ScheduleMaintenance/NotifyOperator via
# a real, live ServiceNow toolkit agent registered in the tenant. Requires
# this explicit opt-in on top of WO_INSTANCE/WO_API_KEY above (which just
# activate the ADK CLI), so the connector is only ever SELECTED once you
# mean it. Leave unset for local dev.
# WO_ITSM_INTEGRATION_ENABLED=true

# Second, independent gate — required in addition to the flag above before
# execute() will make any real network call. CREATE_INCIDENT is governance-
# classified "low" risk (orchestrate/governance.py), so it can fire
# autonomously with no human approval; without this flag, enabling the
# integration above would let every qualifying incident silently create a
# REAL ServiceNow ticket on the live instance. Only set this once you
# specifically intend that. test_connection() (read-only) is unaffected by
# either flag.
# WO_ITSM_LIVE_WRITES_ENABLED=true

# ---------------------------------------------------------------------------
# IBM Watson Natural Language Understanding (knowledge/nlu_client.py)
# Live keyword/entity/sentiment/category extraction. Get NLU_URL + an API
# key from the instance's "Service credentials" page (IBM Cloud console).
# Unset = /ai/nlu/analyze returns 502 "not configured" instead of faking
# results — no fallback text is synthesized.
# ---------------------------------------------------------------------------
# NLU_API_KEY=
# NLU_URL=https://api.<region>.natural-language-understanding.watson.cloud.ibm.com/instances/<id>

# ---------------------------------------------------------------------------
# IBM Watson Text to Speech (knowledge/tts_client.py)
# Live speech synthesis. Get TTS_URL + an API key from the instance's
# "Service credentials" page. Unset = /ai/tts/synthesize returns 502.
# ---------------------------------------------------------------------------
# TTS_API_KEY=
# TTS_URL=https://api.<region>.text-to-speech.watson.cloud.ibm.com/instances/<id>

# Pipeline opt-in: when true (and TTS is configured), every incident the
# orchestrator resolves/fails also gets a spoken briefing synthesized and
# cached in memory, fetchable at GET /incidents/{id}/briefing-audio
# (orchestrate/orchestrator.py's _finalize). Off by default because the
# TTS Lite plan's free quota is small (10,000 characters/month) — this is
# the same "eligibility vs. deliberate opt-in" split used for
# WO_ITSM_LIVE_WRITES_ENABLED above, just protecting quota rather than
# gating a live external write.
# TTS_INCIDENT_BRIEFING_ENABLED=true

# ---------------------------------------------------------------------------
# Local LLM (knowledge/local_llm_client.py) — root-cause reasoning via a
# locally-running Ollama server (https://ollama.com), used in place of a
# managed cloud LLM. Chosen because IBM watsonx.ai Runtime provisioning was
# blocked by this account's catalog policy (COS/WML filtered) — see
# docs/ for the watsonx.ai path if that ever becomes available instead.
# Unset = agents/causal_isolation_agent.py falls back to an honestly
# labeled "Rule-based synthesis (no live LLM configured)" explanation,
# never a fabricated "live model" claim.
# ---------------------------------------------------------------------------
# LOCAL_LLM_ENABLED=true
# LOCAL_LLM_URL=http://localhost:11434
# LOCAL_LLM_MODEL=qwen3:4b
