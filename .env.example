# Copy to .env and fill in real values. .env is gitignored — never commit it.
# See docs/006-integration-hub.md (Secrets Manager) and docs/009-security.md
# for why secrets are brokered here rather than embedded in connector/agent code.

# ---------------------------------------------------------------------------
# IBM watsonx Orchestrate — ADK / CLI (`orchestrate` command)
# Used by orchestrate/ (docs/005-decision-orchestrator.md) and by agents/
# built with the ADK (docs/004-agent-framework.md).
# Get these from your watsonx Orchestrate instance: Settings -> API details
# (service instance URL) and Settings -> Generate API key.
# ---------------------------------------------------------------------------

# Service instance URL for the target Orchestrate environment.
WO_INSTANCE=

# API key for that instance (IBM Cloud / AWS). For on-prem (CPD) auth via
# username+password instead, see `orchestrate env add --help`.
WO_API_KEY=

# Source for the local Developer Edition server: "orchestrate" (IBM Cloud
# entitlement) or "myibm" (Cloud Pak for Data entitlement). Only needed if
# running `orchestrate server start` locally.
WO_DEVELOPER_EDITION_SOURCE=orchestrate

# Set to true only after the first successful `orchestrate server start`,
# to skip re-authenticating against the container registry on every run.
# WO_DEVELOPER_EDITION_SKIP_LOGIN=true

# ---------------------------------------------------------------------------
# Application — filled in as Phase 1 scaffolding (backend/, contracts/,
# infrastructure/) lands. Placeholders for now.
# ---------------------------------------------------------------------------

# ENV=local
# EVENT_BUS_BACKEND=memory   # or "redis" — see EVENT_BUS_URL below
# EVENT_BUS_URL=redis://localhost:6379/0
# SERVICE_AUTH_TOKEN=dev-local-only-token

# ---------------------------------------------------------------------------
# Integration Hub connectors (integrations/connectors/) — docs/006-integration-hub.md
# Unset = that connector reports not-configured and the Connector Policy
# Engine falls back to the console connector (logs + simulates success).
# No sandbox instance is available for either as of Phase 3A — set these
# when a real ServiceNow/SAP dev instance is available to test against.
# ---------------------------------------------------------------------------

# SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
# SERVICENOW_USERNAME=
# SERVICENOW_PASSWORD=

# SAP_BASE_URL=https://your-sap-host/sap/opu/odata/sap
# SAP_API_KEY=

# watsonx Orchestrate ITSM connector (integrations/connectors/watsonx_itsm.py)
# — CreateIncident/CreateChangeRequest/ScheduleMaintenance/NotifyOperator via
# an Orchestrate agent endpoint. Deliberately requires this explicit opt-in
# on top of WO_INSTANCE/WO_API_KEY above (which just activate the ADK CLI) —
# the REST endpoint this connector calls has not been verified against a
# live instance. Leave unset until it has been.
# WO_ITSM_INTEGRATION_ENABLED=true
